{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchResultRow",
  "type": "object",
  "required": ["benchmark", "lang", "metric", "value", "status"],
  "properties": {
    "benchmark": { "type": "string" },
    "lang": { "type": "string" },
    "variant": { "type": "string" },
    "threads": { "type": "integer" },
    "metric": { "type": "string" },
    "value": { "type": "number" },
    "unit": { "type": "string" },
    "git_sha": { "type": "string" },
    "cpu_model": { "type": "string" },
    "flags": { "type": "string" },
    "os": {
      "type": "string",
      "description": "Host OS for this measurement (linux, darwin, windows, unknown)"
    },
    "passed": {
      "type": "boolean",
      "description": "Harness/tier0 correctness pass when exported by producer"
    },
    "status": { "enum": ["green", "yellow", "red", "unknown"] },
    "ratio_vs_cpp": { "type": ["number", "null"] },
    "ratio_vs_sota": {
      "type": ["number", "null"],
      "description": "Li value relative to best competitor in the series (Li is never SOTA)"
    },
    "sota_lang": {
      "type": ["string", "null"],
      "description": "Competitor language with best metric in the row set; never li"
    },
    "validity_status": {
      "enum": ["pass", "fail", "unknown"],
      "description": "Correctness/stability gate for perf claims"
    },
    "validity_source": {
      "type": "string",
      "description": "Provenance: stability.csv, latest.csv:passed, metric:verify_pass, none"
    },
    "repo": { "type": "string" },
    "tier": { "type": "integer" },
    "pillar": { "type": "string" },
    "package": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "ph_ids": { "type": "array", "items": { "type": "string" } },
    "ci_url": { "type": "string" }
  }
}
