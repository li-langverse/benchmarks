# PH-IO-4 — Li ingest smoke: parse lic latest.csv shape via std/io + std/csv
import std.io
import std.csv

def main() raises IO, Alloc -> int
  requires true
  ensures result == 0
  decreases 0
=
  var blob: ptr = io_read_file("fixtures/lic_sample.csv", 65536)
  var data: ptr = io_blob_data(blob)
  var n: int64 = io_blob_len(blob)
  var doc: ptr = csv_parse(data, n)
  if csv_row_count(doc) != 2:
    return 1
  if csv_col_index(doc, "benchmark") != 0:
    return 2
  if csv_col_index(doc, "lang") != 1:
    return 3
  csv_free(doc)
  io_free(blob)
  return 0
