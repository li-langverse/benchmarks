# euler_fluid_2d — pure-Li 1D upwind advection (matches common/euler_fluid_core.c).

extern proc li_rt_volatile_sink_f64(v: float) -> unit
  requires true
  ensures true

extern proc li_rt_sin(x: float) raises IO -> float
  requires true
  ensures true

def main() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var steps: int = 2000
  var coeff: float = 0.5 * 0.001 / 0.05
  var u: array[64, array[1, float]]
  var un: array[64, array[1, float]]
  var i: int = 0
  var fi: float = 0.0
  while i < 64
    u[i][0] = 0.5 + 0.5 * li_rt_sin(0.2 * fi)
    un[i][0] = u[i][0]
    fi = fi + 1.0
    i = i + 1
  var s: int = 0
  while s < steps
    var j: int = 1
    var u_prev: float = u[0][0]
    while j < 63
      var u_curr: float = u[j][0]
      un[j][0] = u_curr - coeff * (u_curr - u_prev)
      u_prev = u_curr
      j = j + 1
    var k: int = 0
    while k < 64
      u[k][0] = un[k][0]
      k = k + 1
    s = s + 1
  li_rt_volatile_sink_f64(u[32][0])
  return 0
