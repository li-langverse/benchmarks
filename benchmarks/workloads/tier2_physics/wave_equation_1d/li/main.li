# wave_equation_1d — tier-2 Li driver (physics-codegen Arm B).
# Kernel: shared C oracle via LI_EXTRA_C → common/wave_core.c (leapfrog + energy).
# Pure-Li blocked on lic: E0201 (i±1 array indices), li_rt_exp broken inside while,
# and release LLVM DCE on nested stencil loops (init-only energy without C oracle).

extern proc li_rt_volatile_sink_f64(v: float) -> unit
  requires true
  ensures true

extern proc li_wave_1d_kernel()
  requires true
  ensures true

extern proc li_wave_1d_checksum() -> float
  requires true
  ensures true

def main() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_wave_1d_kernel()
  li_rt_volatile_sink_f64(li_wave_1d_checksum())
  return 0
