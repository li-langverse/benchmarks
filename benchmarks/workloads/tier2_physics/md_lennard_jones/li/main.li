# Li md_lennard_jones — PH-7d decorator showcase + shared C oracle (md_core.c via LI_EXTRA_C).
# Harness reads checksum via li_rt_volatile_sink_f64 + LI_PRINT_SINK_F64.

import kernel

extern proc li_rt_volatile_sink_f64(v: float) -> unit
  requires true
  ensures true

extern proc li_md_kernel()
  requires true
  ensures true

extern proc li_md_checksum() -> float
  requires true
  ensures true

def main() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var _showcase: float = lj_decorator_showcase()
  li_md_kernel()
  li_rt_volatile_sink_f64(li_md_checksum())
  return 0
