# advection_diffusion_2d — Li driver; Arm B kernel in li/advdiff_kernel.c (oracle: common/).
# Pure-Li stencil blocked on E0201 (neighbor indices i±1/j±1); li-local C matches common/advdiff_core.c.

extern proc li_rt_volatile_sink_f64(v: float) -> unit
  requires true
  ensures true

extern proc li_advdiff_2d_kernel()
  requires true
  ensures true

extern proc li_advdiff_2d_checksum() -> float
  requires true
  ensures true

def main() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_advdiff_2d_kernel()
  li_rt_volatile_sink_f64(li_advdiff_2d_checksum())
  return 0
