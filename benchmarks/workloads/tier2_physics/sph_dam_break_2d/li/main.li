# sph_dam_break_2d — Arm B Li driver; SPH kernel via LI_EXTRA_C (common/sph_dam_core.c).
# Pure-Li port of the 256×8000 pairwise SPH loop is blocked on bit-identical FP vs clang
# under harness --verify-results (chaotic divergence after ~110 steps). Track: lic codegen.

extern proc li_rt_volatile_sink_f64(v: float) -> unit
  requires true
  ensures true

extern proc li_sph_dam_2d_kernel()
  requires true
  ensures true

extern proc li_sph_dam_2d_checksum() -> float
  requires true
  ensures true

def main() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_sph_dam_2d_kernel()
  li_rt_volatile_sink_f64(li_sph_dam_2d_checksum())
  return 0
