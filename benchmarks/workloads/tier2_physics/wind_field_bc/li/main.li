# wind_field_bc — pure-Li 1D upwind advection (matches common/wind_core.c).

extern proc li_rt_volatile_sink_f64(v: float) -> unit
  requires true
  ensures true

def main() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var steps: int = 1000
  var dt: float = 0.01
  var u: array[64, float]
  var i: int = 0
  while i < 64
    u[i] = 1.0
    i = i + 1
  var s: int = 0
  while s < steps
    var left: float = u[0]
    var j: int = 1
    while j < 63
      var curr: float = u[j]
      var next: float = curr - dt * (curr - left)
      u[j] = next
      left = next
      j = j + 1
    s = s + 1
  li_rt_volatile_sink_f64(u[32])
  return 0
