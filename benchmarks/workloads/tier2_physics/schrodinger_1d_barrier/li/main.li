def li_schrodinger_1d_barrier_kernel() -> float
  requires true
  ensures true
  decreases 4000
=
  var re: array[64, float]
  var im: array[64, float]
  var i: int = 0
  while i < 64
    re[i] = gaussian_init(i)
    im[i] = 0.0
    i = i + 1
  var s: int = 0
  while s < 4000
    var j: int = 1
    while j < 63
      var rjm1: float = re_at(re, j - 1)
      var rj: float = re_at(re, j)
      var rjp1: float = re_at(re, j + 1)
      var lap: float = rjp1 - 2.0 * rj + rjm1
      re[j] = rj + 0.0001 * lap
      im[j] = re_at(im, j) + 0.0001 * lap
      j = j + 1
    s = s + 1
  var n2: float = 0.0
  var k: int = 0
  while k < 64
    var rv: float = re_at(re, k)
    var iv: float = re_at(im, k)
    n2 = n2 + rv * rv + iv * iv
    k = k + 1
  return n2

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var checksum: float = li_schrodinger_1d_barrier_kernel()
  li_rt_volatile_sink_f64(checksum)
  return 0
