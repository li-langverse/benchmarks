# combustion_passive — pure-Li passive combustion kernel (matches common/combust_core.c).

extern proc li_rt_volatile_sink_f64(v: float) -> unit
  requires true
  ensures true

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fuel: array[32, float]
  var temp: array[32, float]
  var i: int = 0
  while i < 32
    fuel[i] = 1.0
    temp[i] = 300.0
    i = i + 1
  var s: int = 0
  while s < 500
    var j: int = 0
    while j < 32
      var burned: float = 0.1 * 0.02 * fuel[j]
      if burned > fuel[j]:
        burned = fuel[j]
      fuel[j] = fuel[j] - burned
      temp[j] = temp[j] + burned * 100.0
      j = j + 1
    s = s + 1
  li_rt_volatile_sink_f64(temp[0])
  return 0
