# Pure-Li naive 1D DFT (N=256) — PH-7e codegen surface; no LI_EXTRA_C.

extern proc li_rt_volatile_sink_f64(v: float) -> unit
  requires true
  ensures true

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var re: array[256, float]
  var out_re: array[256, float]
  var i: int = 0
  while i < 256
    re[i] = cos(0.007 * float(i)) + 0.25 * sin(0.019 * float(i))
    i = i + 1
  var rep: int = 0
  while rep < 2
    var k: int = 0
    while k < 256
      var sum: float = 0.0
      var j: int = 0
      while j < 256
        let ang: float = -2.0 * 3.141592653589793 * float(k) * float(j) / 256.0
        sum = sum + re[j] * cos(ang)
        j = j + 1
      out_re[k] = sum
      k = k + 1
    k = 0
    while k < 256
      re[k] = out_re[k]
      k = k + 1
    rep = rep + 1
  var acc: float = 0.0
  i = 0
  while i < 256
    acc = acc + re[i]
    i = i + 1
  li_rt_volatile_sink_f64(acc)
  return 0
