# From lic: li-tests/encapsulation/object_public_field.li + private_field_access.li
# PascalCase type names; public vs private fields on `object` types.
type Point = object
  public x: int
  private tag: int

type Vault = object
  public open: int
  private secret: int

# Typechecker rejects private access outside the defining type:
def leak(v: Vault) -> int
  requires true
  ensures true
  decreases 0
=
  return v.secret
